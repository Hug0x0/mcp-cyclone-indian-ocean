{
  "name": "mcp-cyclone-indian-ocean",
  "version": "0.1.0",
  "description": "MCP server for South-West Indian Ocean cyclone advisories, alerts, archives, and commune-level risk helpers.",
  "type": "module",
  "bin": {
    "mcp-cyclone-indian-ocean": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "cyclone",
    "hurricane",
    "indian-ocean",
    "reunion",
    "mayotte",
    "madagascar",
    "mauritius",
    "meteo-france",
    "rsmc"
  ],
  "author": "Hug0x0",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
